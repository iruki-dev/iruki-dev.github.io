---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800 mt-auto">
  <div class="container flex items-center justify-between h-12 text-sm text-zinc-400 dark:text-zinc-600">
    <span>© {year} {SITE.title}</span>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer"
      class="hover:text-zinc-600 dark:hover:text-zinc-400 transition-colors">
      GitHub
    </a>
  </div>
</footer>
