---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  collection: string;
  slug: string;
  tags?: string[];
  github?: string;
  demo?: string;
}

const { title, description, pubDate, collection, slug, tags = [], github, demo } = Astro.props;

const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const href = `/${collection}/${slug}`;
---

<div class="group block py-5 border-b border-zinc-100 dark:border-zinc-800 hover:border-accent-300 dark:hover:border-accent-700 transition-colors">
  <div class="flex items-baseline justify-between gap-4">
    <a href={href} class="flex-1 min-w-0">
      <h2 class="text-base font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-accent-500 dark:group-hover:text-accent-400 transition-colors">
        {title}
      </h2>
    </a>
    <div class="flex items-center gap-2 shrink-0">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
           class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" aria-label="Live demo"
           class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
      <time class="text-xs text-zinc-400 dark:text-zinc-600">{dateStr}</time>
    </div>
  </div>
  {description && (
    <a href={href} class="block">
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 line-clamp-2">{description}</p>
    </a>
  )}
  {tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-1">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  )}
</div>
