---
import { ymd } from './date';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  collection: string;
  slug: string;
  tags?: string[];
  github?: string;
  demo?: string;
}

const { title, description, pubDate, collection, slug, tags = [], github, demo } = Astro.props;
const href = `/${collection}/${slug}`;
// 뉴스레터 태그(분야)는 목록에서 빼고, 프로젝트는 기술 이름만 한 줄로 보여준다.
const showTags = collection === 'projects' && tags.length > 0;
---

<article class="py-6 border-b border-zinc-200 dark:border-zinc-800">
  <a href={href} class="group block">
    <h3 class="text-lg font-semibold leading-snug text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-4">{title}</h3>
    {description && (
      <p class="mt-2 text-[15px] leading-relaxed text-zinc-600 dark:text-zinc-400 line-clamp-2">{description}</p>
    )}
  </a>
  <div class="mt-3 flex flex-wrap items-center gap-x-2 text-[13px] text-zinc-400 dark:text-zinc-500">
    <time datetime={pubDate.toISOString()}>{ymd(pubDate)}</time>
    {showTags && <><span aria-hidden="true">·</span><span>{tags.join(', ')}</span></>}
    {github && <><span aria-hidden="true">·</span><a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 underline underline-offset-2">GitHub</a></>}
    {demo && <><span aria-hidden="true">·</span><a href={demo} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 underline underline-offset-2">사이트</a></>}
  </div>
</article>
