---
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const HOME_SLUG = 'home';
const slugOf = (p: any) => p.slug ?? p.id.replace(/\.json$/, '');

const navPages = await getCollection('pages', ({ data }) => !data.draft && data.showInNav);

const navLinks = navPages
  .map((p) => {
    const s = slugOf(p);
    return {
      href: s === HOME_SLUG ? '/' : `/${s}`,
      label: p.data.navLabel || p.data.title,
      order: p.data.navOrder ?? 0,
    };
  })
  .sort((a, b) => a.order - b.order || a.label.localeCompare(b.label));

const { pathname } = Astro.url;
---

<header class="sticky top-0 z-50 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
  <div class="container flex items-center justify-between h-14">
    <a href="/" class="font-semibold text-zinc-900 dark:text-zinc-100 hover:text-accent-500 dark:hover:text-accent-400 transition-colors">
      {SITE.title}
    </a>
    <nav class="flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'px-3 py-1.5 rounded-md text-sm transition-colors',
            (href === '/' ? pathname === '/' : pathname.startsWith(href))
              ? 'text-accent-500 dark:text-accent-400 font-medium'
              : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800',
          ]}
        >
          {label}
        </a>
      ))}
      <div class="ml-1 border-l border-zinc-200 dark:border-zinc-800 pl-2">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
