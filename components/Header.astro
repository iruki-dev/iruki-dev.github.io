---
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const HOME_SLUG = 'home';
const slugOf = (p: any) => p.slug ?? p.id.replace(/\.json$/, '');

const navPages = await getCollection('pages', ({ data }) => !data.draft && data.showInNav);

const navLinks = navPages
  .map((p) => {
    const s = slugOf(p);
    return {
      href: s === HOME_SLUG ? '/' : `/${s}`,
      label: p.data.navLabel || p.data.title,
      order: p.data.navOrder ?? 0,
    };
  })
  .sort((a, b) => a.order - b.order || a.label.localeCompare(b.label));

const { pathname } = Astro.url;
---

<header class="border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
  <div class="container flex items-center justify-between h-14 gap-3">
    <a href="/" class="flex items-center gap-2 shrink-0 font-bold text-[17px] text-zinc-900 dark:text-zinc-100">
      <img src="/avatar.png" alt="" width="24" height="24" class="w-6 h-6 rounded-full border border-zinc-200 dark:border-zinc-700" />
      {SITE.title}
    </a>
    <nav class="flex items-center min-w-0">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'px-2 sm:px-3 py-1.5 text-[15px] whitespace-nowrap',
            (href === '/' ? pathname === '/' : pathname.startsWith(href))
              ? 'text-zinc-900 dark:text-zinc-100 font-semibold'
              : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100',
          ]}
        >
          {label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>
