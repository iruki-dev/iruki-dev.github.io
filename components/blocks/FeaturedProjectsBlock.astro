---
import { getCollection } from 'astro:content';
import ProjectCard from '../ProjectCard.astro';

const { block } = Astro.props as { block: any };
const limitRaw = Number(block.limit);
const limit = Number.isFinite(limitRaw) ? limitRaw : 3;

const all = (await getCollection('projects', ({ data }) => {
  if (data.draft) return false;
  if (block.featuredOnly !== false) return data.featured;
  return true;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projects = limit > 0 ? all.slice(0, limit) : all;
---
{projects.length > 0 && (
  <section class="mb-10">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-600">
        {block.title || 'Projects'}
      </h2>
      {block.showAllLink !== false && limit > 0 && limit < all.length && (
        <a href="/projects" class="text-sm link">All projects →</a>
      )}
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          slug={project.slug}
          tags={project.data.tags}
          github={project.data.github}
          demo={project.data.demo}
        />
      ))}
    </div>
  </section>
)}
