---
import { getCollection } from 'astro:content';
import PostCard from '../PostCard.astro';

const { block } = Astro.props as { block: any };
const limitRaw = Number(block.limit);
const limit = Number.isFinite(limitRaw) ? limitRaw : 3;

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = limit > 0 ? all.slice(0, limit) : all;
---
{posts.length > 0 && (
  <section class="mb-10">
    <div class="flex items-baseline justify-between mb-1">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-600">
        {block.title || 'Recent posts'}
      </h2>
      {block.showAllLink !== false && limit > 0 && limit < all.length && (
        <a href="/blog" class="text-sm link">All posts →</a>
      )}
    </div>
    <div>
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.slug}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>
)}
