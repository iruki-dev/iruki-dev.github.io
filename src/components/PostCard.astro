---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="group block py-5 border-b border-zinc-100 dark:border-zinc-800 hover:border-accent-300 dark:hover:border-accent-700 transition-colors">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-base font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-accent-500 dark:group-hover:text-accent-400 transition-colors">
      {title}
    </h2>
    <time class="shrink-0 text-xs text-zinc-400 dark:text-zinc-600">{dateStr}</time>
  </div>
  <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 line-clamp-2">{description}</p>
  {tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-1">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  )}
</a>
