---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  github?: string;
  demo?: string;
  collection: string;
  collectionLabel: string;
}

const {
  title, description, pubDate, updatedDate,
  tags = [], github, demo,
  collection, collectionLabel,
} = Astro.props;

const pubDateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedDateStr = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8 pb-8 border-b border-zinc-100 dark:border-zinc-800">
      <div class="flex flex-wrap gap-1 mb-3">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h1 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100">{title}</h1>
      {description && (
        <p class="mt-2 text-zinc-500 dark:text-zinc-400">{description}</p>
      )}
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-400 dark:text-zinc-600">
        <time datetime={pubDate.toISOString()}>Published {pubDateStr}</time>
        {updatedDate && (
          <span>· Updated <time datetime={updatedDate.toISOString()}>{updatedDateStr}</time></span>
        )}
        {(github || demo) && <span>·</span>}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="link">GitHub ↗</a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="link">Live demo ↗</a>
        )}
      </div>
    </header>
    <div class="prose dark:prose-invert max-w-none
                prose-headings:font-semibold
                prose-a:text-accent-500 prose-a:no-underline hover:prose-a:underline
                dark:prose-a:text-accent-400
                prose-code:before:content-none prose-code:after:content-none
                prose-code:bg-zinc-100 dark:prose-code:bg-zinc-800
                prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                prose-pre:bg-zinc-900 dark:prose-pre:bg-zinc-900">
      <slot />
    </div>
  </article>
  <div class="mt-12 pt-6 border-t border-zinc-100 dark:border-zinc-800">
    <a href={`/${collection}`} class="text-sm text-accent-500 dark:text-accent-400 hover:underline">← All {collectionLabel.toLowerCase()}</a>
  </div>
</BaseLayout>
