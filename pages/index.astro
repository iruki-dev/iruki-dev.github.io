---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlock from '../components/blocks/PageBlock.astro';
import { getCollection } from 'astro:content';

const HOME_SLUG = 'home';
const slugOf = (p: any) => p.slug ?? p.id.replace(/\.json$/, '');

const home = (await getCollection('pages', ({ data }) => !data.draft))
  .find((p) => slugOf(p) === HOME_SLUG);
---

<BaseLayout title={home?.data.title ?? 'iruki.dev'} description={home?.data.description}>
  {home ? (
    home.data.blocks.map((block) => <PageBlock block={block} />)
  ) : (
    <div class="prose dark:prose-invert max-w-none">
      <h1>iruki.dev</h1>
      <p>
        No <code>home</code> page yet. Create one in the admin tool (<code>npm run admin</code>) —
        or add <code>content/pages/home.json</code> with a <code>blocks</code> array.
      </p>
    </div>
  )}
</BaseLayout>
