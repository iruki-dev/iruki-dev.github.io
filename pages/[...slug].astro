---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlock from '../components/blocks/PageBlock.astro';

export async function getStaticPaths() {
  const slugOf = (p: any) => p.slug ?? p.id.replace(/\.json$/, '');
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  // 'home' is rendered at / by pages/index.astro — skip it here.
  return pages
    .filter((p) => slugOf(p) !== 'home')
    .map((p) => ({
      params: { slug: slugOf(p) },
      props: p,
    }));
}

const page = Astro.props;
const { data } = page;
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    {data.blocks.map((block) => <PageBlock block={block} />)}
  </article>
</BaseLayout>
