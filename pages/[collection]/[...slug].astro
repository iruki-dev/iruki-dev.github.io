---
import { getCollection } from 'astro:content';
import CollectionPost from '../../layouts/CollectionPost.astro';
import { COLLECTIONS } from '../../config';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const def of COLLECTIONS) {
    const items = (await getCollection(def.name as any, ({ data }: any) => !data.draft))
      .sort((a: any, b: any) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
    items.forEach((item: any, i: number) => {
      const link = (it: any) => it && { href: `/${def.name}/${it.slug}`, title: it.data.title };
      paths.push({
        params: { collection: def.name, slug: item.slug },
        props: { item, def, prev: link(items[i - 1]), next: link(items[i + 1]) },
      });
    });
  }
  return paths;
}

const { item, def, prev, next } = Astro.props as { item: any; def: any; prev?: any; next?: any };
const { Content } = await item.render();
---

<CollectionPost
  title={item.data.title}
  description={item.data.description}
  pubDate={item.data.pubDate}
  updatedDate={item.data.updatedDate}
  tags={item.data.tags}
  github={item.data.github}
  demo={item.data.demo}
  collection={def.name}
  collectionLabel={def.label}
  prev={prev}
  next={next}
>
  <Content />
</CollectionPost>
